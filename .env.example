# ---------------------------------------------------------------------------
# LinguaCard environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored.
# These are PUBLIC client keys (they ship inside the binary) — they are kept
# in env vars for per-environment values and rotation, not for secrecy.
#
# NEVER put the RevenueCat SECRET key (sk_...) in this file or in the app.
# ---------------------------------------------------------------------------

# RevenueCat public SDK keys — https://app.revenuecat.com > Project > API keys
EXPO_PUBLIC_RC_IOS_KEY=appl_
EXPO_PUBLIC_RC_ANDROID_KEY=goog_

# AdMob — https://apps.admob.com
# App IDs look like  ca-app-pub-0000000000000000~0000000000
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
# Rewarded ad unit IDs look like  ca-app-pub-0000000000000000/0000000000
EXPO_PUBLIC_ADMOB_IOS_REWARDED_ID=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_ID=

# Legal URLs — required by App Store Review Guidelines 3.1.2 and 5.1.1(i)
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
